# pwnm-sync configuration: copy to ~/.config/pwnm-sync
#
# [Defaults] gives the options their default values, under the option's long
# name with dashes as underscores. The command line overrides them.

[Defaults]
# Patchwork projects to sync, comma separated. Required, here or with -p.
project = linux-foo

# Needed to write to patchwork; get it from /user/ on the instance.
# PWNM_SYNC_TOKEN in the environment overrides it.
#patchwork_token = abcdef1234567890

# Run by --with-token-cmd alone, which takes the token from the first line it
# prints instead.
#patchwork_token_command = pass show patchwork.kernel.org

#patchwork_url = https://patchwork.kernel.org

# The notmuch database; the one notmuch is configured with when unset.
#notmuch_database = ~/.mail

#syncdb = ~/.local/state/pwnm-sync/pwnm-sync.db

# Patches handled while the notmuch database is held open for writing, and
# events read per request (patchwork serves at most 250).
#batch = 250

# Patch states that get a tag, comma separated; only settable here.
#states = new, under-review, changes-requested, awaiting-upstream,
#  handled-elsewhere, not-applicable, superseded, accepted, rejected, deferred,
#  rfc

# Optional: the prefix a project's tags are named after, pw-{project} otherwise.
#[Prefixes]
#linux-foo = pw-foo

# Optional: tag names on the left, after the prefix change, and the ones to use
# instead on the right. Only the new names are synced; tags left under their
# old names are yours.
#[Aliases]
#patchwork = pw
#pw-foo-accepted = foo/applied
#pw-foo-delegate-jdoe = foo/mine
